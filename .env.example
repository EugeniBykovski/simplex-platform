# Public origin, no path. Needed for an indexable build, and set it to the production domain in
# every environment so previews never advertise themselves as canonical. Falls back to
# http://localhost:3000, which is safe because such builds are always noindex.
# NEXT_PUBLIC_SITE_URL=https://example.com

# "true" only on the production deployment, which also needs a public https URL above.
# Anything else gives noindex. Vercel previews stay noindex even if this is set.
SITE_INDEXABLE=false

# Renders unapproved legal drafts, with a draft notice, for internal review. Read at build. Fails a
# production or indexable build. Keep such a deployment protected.
# LEGAL_REVIEW_MODE=true

# Contact form delivery, server only. Builds do not need these. Never prefix with NEXT_PUBLIC_.
# Unset means the form shows its unavailable state and sends nothing.
#
# Local simulation. Works only on a loopback host, in a build with no public site URL, outside
# hosted environments. It never sends email:
# EMAIL_PROVIDER=mock
#
# Real delivery. All of these are needed, and CONTACT_LIVE_ENABLED stays unset until the activation
# procedure in docs/architecture/contact-and-email.md has been completed:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=
# CONTACT_LIVE_ENABLED=true
