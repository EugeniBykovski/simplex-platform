# Public origin, no path. Needed for an indexable build, and set it to the production domain in
# every environment so previews never advertise themselves as canonical. Falls back to
# http://localhost:3000, which is safe because such builds are always noindex.
# NEXT_PUBLIC_SITE_URL=https://example.com

# "true" only on the production deployment, which also needs a public https URL above.
# Anything else gives noindex. Vercel previews stay noindex even if this is set.
SITE_INDEXABLE=false

# Server-only, used by SF-151 when email is first sent. Builds do not need them.
# Never prefix with NEXT_PUBLIC_.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_INBOX_EMAIL=
